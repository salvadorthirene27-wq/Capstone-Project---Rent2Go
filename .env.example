DATABASE_URL=postgresql://NEW_RUNTIME_ROLE:password@NEW_HOST/rent2go?sslmode=require
MIGRATION_DATABASE_URL=postgresql://NEW_OWNER_ROLE:password@NEW_HOST/rent2go?sslmode=require
TEST_DATABASE_URL=postgresql://NEW_OWNER_ROLE:password@NEW_HOST/rent2go_test?sslmode=require
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
APP_ORIGIN=http://localhost:3100
LOCAL_DEMO_LOOPBACK_ALIASES=true
STORAGE_DRIVER=local
STORAGE_BUCKET=partner-evidence
# S3 variables are required only for STORAGE_DRIVER=s3.
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional document text assistance. Keep the real key in .env.local only.
OCR_SPACE_API_KEY=

# Optional free Gmail sender. Real credentials belong only in ignored local/server secrets.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Rent2Go
# Enabling dispatch is an explicit operational step; preferences alone send nothing.
EMAIL_SEND_ENABLED=false

# PayMongo hosted checkout. Keep real keys only in ignored/server secrets.
# Test provider payments transfer no money. Live activation is a separate step.
PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_LIVE_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
# Local servers can retrieve provider status without exposing the site publicly.
# Webhook mode requires a registered HTTPS endpoint and its actual signing secret.
PAYMONGO_NOTIFICATION_MODE=poll

# Start only after the complete payment workflow is configured and validated.
PAYMONGO_WORKER_ENABLED=false
